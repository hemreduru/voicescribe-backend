APP_NAME=VoiceScribe
# Production-safe defaults. For local development set APP_ENV=local and
# APP_DEBUG=true in your own .env (never in production: debug pages leak stack
# traces and configuration).
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://vsbackend.test

# DEV/TEST ONLY: skip login password verification for the mobile test build.
# Must stay false (or unset) in production; it is additionally hard-gated
# against APP_ENV=production in code. See config/voicescribe.php.
AUTH_PASSWORD_BYPASS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Container deployments: log to stderr so unhandled exceptions land in the
# container logs (Dokploy log viewer / docker logs). For local development use
# LOG_STACK=single (storage/logs/laravel.log) or single,stderr.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Reverse proxy trust. Comma-separated proxy IPs/CIDRs allowed to set
# X-Forwarded-* headers, or "*" to trust every hop (only if the container is
# unreachable except through the proxy). Empty/unset defaults to PRIVATE_SUBNETS
# (Traefik inside the Docker network on Dokploy) so clients on public IPs cannot
# spoof their IP and dodge the rate limiters.
TRUSTED_PROXIES=

# Browser origins allowed by CORS (comma-separated, e.g. https://app.example.com).
# Native mobile clients do not use CORS; leave empty to allow no cross-origin access.
CORS_ALLOWED_ORIGINS=

# Sanctum access-token lifetime in minutes (default 43200 = 30 days). Expired
# tokens get 401 and are pruned daily by the scheduler (sanctum:prune-expired).
SANCTUM_TOKEN_EXPIRATION=43200

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vsbackend
DB_USERNAME=vsbackend_app
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@voicescribe.app"
MAIL_FROM_NAME="${APP_NAME}"

# LLM Provider Configuration
# Active remote provider for summarization. Switch this to swap providers without
# code changes (each provider block lives in config/llm.php).
LLM_DEFAULT_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (OpenAI-compatible, free tier). Fill the key to enable speech-to-text
# (POST /api/v1/transcribe) and/or flip LLM_DEFAULT_PROVIDER=groq for summaries.
# The key is server-side only and is never sent to clients.
GROQ_API_KEY=
# Speech-to-text model used by POST /api/v1/transcribe.
GROQ_STT_MODEL=whisper-large-v3-turbo
# Max uploaded audio chunk size in KB (default 10 MB). Keep below the 16M
# PHP/nginx body limit (Dockerfile); Groq's free tier limit is 25 MB.
TRANSCRIBE_MAX_SIZE_KB=10240
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2048
GROQ_BASE_URL=https://api.groq.com/openai/v1

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_MAX_TOKENS=2048

# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Swap the model with this one var. gemini-2.5-flash / -flash-lite return clean
# JSON. Provider is also swappable via LLM_DEFAULT_PROVIDER (gemini | openai-compatible).
GEMINI_MODEL=gemini-2.5-flash
# Fallback chain (comma-separated). Each model has its own daily free-tier quota;
# the provider rotates to the next on 429/5xx, summing capacity.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-2.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

LLM_CHUNK_SIZE=4000
LLM_CACHE_TTL=3600
LLM_REQUEST_TIMEOUT=60

# Throttles (requests per minute): auth = per IP, llm and transcribe = per user.
# Mobile sends one transcribe request per ~15 s audio chunk (~4/min while recording).
RATE_LIMIT_AUTH=10
RATE_LIMIT_LLM=20
RATE_LIMIT_TRANSCRIBE=60

# Sync Configuration
SYNC_ENABLED=true
SYNC_MAX_BATCH=50
SYNC_CONFLICT=updated_at

# Local auth
# Sanctum access tokens are created by /api/v1/auth/login and /api/v1/auth/register
