APP_NAME=VoiceScribe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://vsbackend.test

# DEV/TEST ONLY: skip login password verification for the mobile test build.
# Must stay false (or unset) in production; it is additionally hard-gated
# against APP_ENV=production in code. See config/voicescribe.php.
AUTH_PASSWORD_BYPASS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vsbackend
DB_USERNAME=vsbackend_app
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@voicescribe.app"
MAIL_FROM_NAME="${APP_NAME}"

# LLM Provider Configuration
# Active remote provider for summarization. Switch this to swap providers without
# code changes (each provider block lives in config/llm.php).
LLM_DEFAULT_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (OpenAI-compatible, free tier). Just fill the key + flip LLM_DEFAULT_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_BASE_URL=https://api.groq.com/openai/v1

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_MAX_TOKENS=2048

# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Swap the model with this one var. gemini-2.5-flash / -flash-lite return clean
# JSON; gemma-4-* are reasoning models (no clean JSON). Provider is also
# swappable via LLM_DEFAULT_PROVIDER (gemini | openai-compatible).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

LLM_CHUNK_SIZE=4000
LLM_CACHE_TTL=3600
LLM_REQUEST_TIMEOUT=60

# On-device summary model, served to the app via GET /api/v1/local-summary-model.
# Token is the gated-model (HuggingFace) auth token; kept server-side, never bundled
# in the app binary.
LOCAL_LLM_MODEL_URL=https://huggingface.co/litert-community/Gemma3-1B-IT/resolve/main/Gemma3-1B-IT_multi-prefill-seq_q8_ekv4096.task
LOCAL_LLM_MODEL_TOKEN=
LOCAL_LLM_MODEL_FILE=Gemma3-1B-IT_multi-prefill-seq_q8_ekv4096.task
LOCAL_LLM_MODEL_SIZE=1054023846
LOCAL_LLM_MODEL_TYPE=gemmaIt
LOCAL_LLM_MODEL_FILE_TYPE=task
LOCAL_LLM_MODEL_LABEL="Gemma 3 1B"

# Sync Configuration
SYNC_ENABLED=true
SYNC_MAX_BATCH=50
SYNC_CONFLICT=updated_at

# Local auth
# Sanctum access tokens are created by /api/v1/auth/login and /api/v1/auth/register
